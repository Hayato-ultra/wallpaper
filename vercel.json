{
  "buildCommand": "bash vercel_build.sh",
  "installCommand": "pip install -r requirements.txt && npm ci --production=false --ignore-scripts",
  "framework": null,
  "builds": [
    {
      "src": "config/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "config/wsgi.py"
    },
    {
      "src": "/media/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "dest": "config/wsgi.py"
    },
    {
      "src": "/explore/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=300, stale-while-revalidate=600"
      },
      "dest": "config/wsgi.py"
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "public, max-age=120, stale-while-revalidate=300"
      },
      "dest": "config/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "config/wsgi.py"
    }
  ]
}
